{
  "name": "codex-suite",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "Codex delegation to Grok Build over ACP and OpenCode 2 CLI",
  "repository": "https://github.com/lllyys/codex-suite",
  "license": "ISC",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "init-project": "node skills/codex-suite-init/scripts/init-config.mjs",
